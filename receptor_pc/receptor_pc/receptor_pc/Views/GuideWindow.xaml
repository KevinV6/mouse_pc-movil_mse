<ui:FluentWindow x:Class="receptor_pc.Views.GuideWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Guía de Uso — MSE Receptor PC"
                 Width="760"
                 Height="520"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Guía de Uso y Seguridad — MSE Receptor PC" Grid.Row="0" />

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Section Selector -->
            <ui:Card Grid.Column="0" Padding="8" VerticalAlignment="Stretch">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,8">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ui:Card>

            <!-- Selected Section Content -->
            <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedSection}">
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource MseTitleTextStyle}"
                                   FontSize="20"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Style="{StaticResource MseCaptionTextStyle}"
                                   FontSize="13"
                                   Margin="0,0,0,18" />

                        <ItemsControl ItemsSource="{Binding BulletPoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12" CornerRadius="8" Background="#14808080">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                                           FontSize="18"
                                                           Margin="0,2,12,0"
                                                           VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap"
                                                       FontSize="13.5"
                                                       LineHeight="20" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
