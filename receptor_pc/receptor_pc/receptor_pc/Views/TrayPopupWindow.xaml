<ui:FluentWindow x:Class="receptor_pc.Views.TrayPopupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="MSE Receptor"
                 Width="390"
                 Height="640"
                 ShowInTaskbar="False"
                 Topmost="True"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Deactivated="OnWindowDeactivated">
    <Grid Margin="14,10,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="2,4,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource MseAccentBrush}" Margin="0,0,10,0">
                <ui:SymbolIcon Symbol="PhoneDesktop24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding ServerName}" Style="{StaticResource MseTitleTextStyle}" FontSize="15" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MseCaptionTextStyle}" />
            </StackPanel>

            <ui:Button Grid.Column="2"
                       Content="Pausar / Reanudar"
                       Icon="{ui:SymbolIcon Power24}"
                       Appearance="Secondary"
                       FontSize="11"
                       Padding="8,5"
                       Command="{Binding ToggleServerCommand}" />
        </Grid>

        <!-- Scrollable Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Connection Info Card -->
                <ui:Card Margin="0,0,0,10" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Wifi124" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Dirección local (Wi-Fi / LAN)" Style="{StaticResource MseCaptionTextStyle}" />
                            <TextBlock Text="{Binding AddressDisplay}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <ui:Button Grid.Column="2"
                                   Content="{Binding CopyFeedback}"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Command="{Binding CopyAddressCommand}"
                                   Padding="10,5" />
                    </Grid>
                </ui:Card>

                <!-- QR + PIN Pairing Card -->
                <ui:Card Margin="0,0,0,10" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Emparejar dispositivo" Style="{StaticResource MseSectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1"
                                       Content="Nuevo PIN"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Command="{Binding NewPinCommand}"
                                       FontSize="11"
                                       Padding="8,4" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="140" Height="140" CornerRadius="10" Background="White" Padding="6" Margin="0,0,12,0">
                                <Image Source="{Binding QrImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="PIN DE SEGURIDAD" Style="{StaticResource MseCaptionTextStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PinFormatted}"
                                           FontFamily="Consolas"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="0,2,0,10" />

                                <TextBlock Text="CÓDIGO DE VERIFICACIÓN" Style="{StaticResource MseCaptionTextStyle}" />
                                <TextBlock Text="{Binding VerificationCode}"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,10" />

                                <CheckBox Content="Permitir nuevos"
                                          IsChecked="{Binding PairingOpen, Mode=TwoWay}"
                                          FontSize="11.5" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Connected Devices Card -->
                <ui:Card Margin="0,0,0,10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Dispositivos conectados ahora"
                                   Style="{StaticResource MseSectionHeaderTextStyle}"
                                   Margin="0,0,0,6" />

                        <ItemsControl ItemsSource="{Binding ConnectedDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6" Margin="0,2" CornerRadius="6" Background="#14808080">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="Phone24" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Text="{Binding StatusSubtitle}" Style="{StaticResource MseCaptionTextStyle}" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="2"
                                                       Content="Desconectar"
                                                       FontSize="11"
                                                       Padding="7,3"
                                                       Margin="4,0"
                                                       Command="{Binding DisconnectCommand}" />
                                            <ui:Button Grid.Column="3"
                                                       Content="Revocar"
                                                       Appearance="Danger"
                                                       FontSize="11"
                                                       Padding="7,3"
                                                       Command="{Binding RevokeCommand}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Trusted Devices Expander -->
                        <Expander Header="Dispositivos de confianza guardados" Margin="0,8,0,0" FontSize="12">
                            <ItemsControl ItemsSource="{Binding TrustedDevices}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="Medium" FontSize="12" />
                                                <TextBlock Text="{Binding StatusSubtitle}" Style="{StaticResource MseCaptionTextStyle}" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1"
                                                       Content="Revocar acceso"
                                                       Appearance="Secondary"
                                                       FontSize="11"
                                                       Padding="8,3"
                                                       Command="{Binding RevokeCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ui:Card>

                <!-- AutoStart Card -->
                <ui:Card Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Iniciar con Windows" FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock Text="Ejecutar oculto en la bandeja del sistema" Style="{StaticResource MseCaptionTextStyle}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2"
                                         IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       HorizontalAlignment="Stretch"
                       Content="Guía de Uso"
                       Icon="{ui:SymbolIcon QuestionCircle24}"
                       Command="{Binding OpenGuideCommand}" />

            <ui:Button Grid.Column="2"
                       HorizontalAlignment="Stretch"
                       Content="Salir completamente"
                       Icon="{ui:SymbolIcon ArrowExit20}"
                       Appearance="Danger"
                       Command="{Binding ExitAppCommand}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
